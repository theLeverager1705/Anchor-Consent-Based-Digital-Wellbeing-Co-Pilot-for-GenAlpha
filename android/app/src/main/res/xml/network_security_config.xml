<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is allowed so a hackathon demo can talk to an Anchor Relay running on a laptop
  over local Wi-Fi (http://192.168.x.x:8787). Production relays must use HTTPS; the app
  warns in Settings whenever an http:// relay is configured.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
